    private void ApplyResult()
    {
        _mainText = resultText;
        TransformService.RemoveAllTransforms(transformCollection);
        UpdateResult();
    }

    private async Task CopyToClipboard()
    {
        if (!string.IsNullOrEmpty(resultText))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", resultText);
            statusText = "Copied to clipboard!";
        }
    }

    private async Task CopyTab()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", "\t");
        statusText = "Copied tab to clipboard!";
    }

    private bool TryGetSelectedTransform(out ITransform selected)
    {
        selected = null!;
        if (selectedTransformIndex < 0 || selectedTransformIndex >= transformCollection.Count)
        {
            return false;
        }

        selected = transformCollection.AsDataSource()[selectedTransformIndex];
        return true;
    }

    private enum BatchUpdatePart
    {
        Source,
        Selection,
        Transform
    }

    private void OnBatchSourceChanged()
    {
        if (batchJustOpened)
        {
            var firstLine = BatchSource.Split(new[] { "\r\n", "\n" }, StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? BatchSource;
            batchSelection = firstLine;
            batchTransform = firstLine;
            batchTransformNotChanged = true;
            UpdateBatchResult(BatchUpdatePart.Source);
            UpdateBatchResult(BatchUpdatePart.Selection);
            UpdateBatchResult(BatchUpdatePart.Transform);
        }
        else
        {
            UpdateBatchResult(BatchUpdatePart.Source);
        }
    }

    private void OnBatchSelectionChanged()
    {
        if (batchTransformNotChanged && !string.IsNullOrEmpty(batchSelection))
        {
            batchTransform = batchSelection;
            UpdateBatchResult(BatchUpdatePart.Selection);
            UpdateBatchResult(BatchUpdatePart.Transform);
        }
        else
        {
            UpdateBatchResult(BatchUpdatePart.Selection);
        }

        if (batchJustOpened)
        {
            batchJustOpened = false;
        }
    }

    private void OnBatchTransformChanged()
    {
        UpdateBatchResult(BatchUpdatePart.Transform);

        if (batchTransformNotChanged)
        {
            batchJustOpened = false;
            batchTransformNotChanged = false;
        }
    }

    private void UpdateBatchResult(BatchUpdatePart part)
    {
        var sourceUpdated = false;

        if (part == BatchUpdatePart.Source || batchLines.Count == 0)
        {
            batchLines = BatchSource
                .Split(new[] { "\r\n", "\n" }, StringSplitOptions.None)
                .Select(line => NewBatchTransform(line))
                .ToList();
            sourceUpdated = true;
        }

        string ApplyTransforms(Func<IBatchEditLineTransform, IBatchEditLineTransform> action)
        {
            var results = new List<string>();
            foreach (var line in batchLines)
            {
                var updated = action(line);
                results.Add((updated as GroupTransform)?.Result ?? string.Empty);
            }
            return string.Join(Environment.NewLine, results);
        }

        if (!string.IsNullOrEmpty(batchSelection) && (part == BatchUpdatePart.Selection || sourceUpdated))
        {
            batchResult = ApplyTransforms(line => line.Select(batchSelection).SetTransform(batchTransform));
            batchSelectionView = string.Join(Environment.NewLine, batchLines.Select(line => (line as GroupTransform)?.Selection ?? string.Empty));
        }
        else if (!string.IsNullOrEmpty(batchSelection) && !string.IsNullOrEmpty(batchTransform))
        {
            batchResult = ApplyTransforms(line => line.SetTransform(batchTransform));
        }
        else if (string.IsNullOrEmpty(batchTransform) && part == BatchUpdatePart.Transform)
        {
            foreach (var line in batchLines)
            {
                line.SetTransform(batchTransform);
            }
            batchResult = string.Empty;
        }
    }

    private IBatchEditLineTransform NewBatchTransform(string text)
    {
        IBatchEditLineTransform transform = batchSelectionMode ? new GroupTransform(text) : new FormatTransform(text);
        if (transform is GroupTransform group)
        {
            group.Predecessor = batchChangeAsterisk ? TransformFactory.CreateFindReplaceTransform("*", "§") : null;
        }
        return transform;
    }

    private void SetBatchMode(bool selectionMode)
    {
        if (batchSelectionMode == selectionMode)
        {
            return;
        }

        batchSelectionMode = selectionMode;
        ChangeBatchEditMode();
    }

    private void ChangeBatchEditMode()
    {
        var newType = batchSelectionMode ? typeof(GroupTransform) : typeof(FormatTransform);

        if (batchLines.Count > 0 && batchLines[0].GetType() != newType)
        {
            var newLines = new List<IBatchEditLineTransform>();
            foreach (var line in batchLines)
            {
                var lineText = (line as GroupTransform)?.Line ?? string.Empty;
                var newTransform = NewBatchTransform(lineText);
                newLines.Add(line.CopyTo(newTransform));
            }
            batchLines = newLines;
        }

        UpdateBatchModeInfo();
        UpdateBatchResult(BatchUpdatePart.Selection);
    }

    private void UpdateBatchModeInfo()
    {
        var sample = NewBatchTransform(string.Empty);
        if (sample is GroupTransform group)
        {
            batchDescription = group.GetDescription();
            batchTransformDescription = group.GetTransformDescription();
            batchHint = group.GetTransformHint();
        }
    }

    private void OnBatchAsteriskChanged(ChangeEventArgs e)
    {
        foreach (var line in batchLines)
        {
            if (line is GroupTransform group)
            {
                group.Predecessor = batchChangeAsterisk ? TransformFactory.CreateFindReplaceTransform("*", "§") : null;
            }
        }
        UpdateBatchResult(BatchUpdatePart.Selection);
    }

    private void ResetBatchEdit()
    {
        BatchSelection = string.Empty;
        BatchTransform = string.Empty;
        batchJustOpened = true;
        batchTransformNotChanged = true;
        var current = BatchSource;
        BatchSource = string.Empty;
        BatchSource = current;
    }

    private async Task CopyBatchResult()
    {
        if (!string.IsNullOrEmpty(batchResult))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", batchResult);
            statusText = "Copied batch result to clipboard!";
        }
    }

    private void UseBatchTransform()
    {
        if (!batchLines.Any(line => (line as GroupTransform)?.Match == true))
        {
            statusText = "Batch edit: no matches found.";
            return;
        }

        var selectedLine = batchLines.First(line => (line as GroupTransform)?.Match == true);

        if (selectedLine is GroupTransform group)
        {
            group.OnlyViewAffectedLines = true;
            group.Predecessor = null;
        }

        var transforms = new List<ITransform>();
        if (batchChangeAsterisk)
        {
            transforms.Add(TransformFactory.CreateFindReplaceTransform("*", "§"));
            transforms.Add(selectedLine);
            transforms.Add(TransformFactory.CreateFindReplaceTransform("§", "*"));
        }
        else
        {
            transforms.Add(selectedLine);
        }

        AddMacro(transforms);
    }

    private void ApplyBatchCosmosReplace()
    {
        batchCosmosHint = string.Empty;
        var regex = new System.Text.RegularExpressions.Regex("(.+),(.+)");
        var lines = batchLines.Where(line => regex.IsMatch((line as GroupTransform)?.Result ?? string.Empty)).ToList();

        if (lines.Count == 0)
        {
            batchCosmosHint = "Please ensure some lines are in the form \"+*,+*\"";
            return;
        }

        if (batchCosmosText.Count(c => c == '*') != 1)
        {
            batchCosmosHint = "Please include one * here:";
            return;
        }

        var foundTransforms = new List<ITransform>();
        foreach (var line in lines)
        {
            var match = regex.Match((line as GroupTransform)?.Result ?? string.Empty);
            if (!match.Success || match.Groups.Count != 3)
            {
                continue;
            }

            var text = $",{match.Groups[1].Value}";
            var replaceWith = $",'{match.Groups[2].Value}'";
            if (!string.IsNullOrEmpty(batchCosmosText))
            {
                text = batchCosmosText.Replace("*", text);
                replaceWith = batchCosmosText.Replace("*", replaceWith);
            }

            foundTransforms.Add(TransformFactory.CreateFindReplaceTransform(text, replaceWith));
        }

        foundTransforms.Insert(0, TransformFactory.CreateFindReplaceTransform(", ", ","));
        foundTransforms.Add(TransformFactory.CreateFindReplaceTransform("'true'", "true"));
        foundTransforms.Add(TransformFactory.CreateFindReplaceTransform("'false'", "false"));
        foundTransforms.Add(TransformFactory.CreateFindReplaceTransform("(label)", "('label')"));

        AddMacro(foundTransforms);
    }

    private void SetBatchCosmosTemplate()
    {
        BatchSelection = "+\t\t[*]\t{[*, *]}*";
        BatchTransform = "\\**,*\\*";
    }

    private void LoadResultIntoBatch()
    {
        BatchSource = resultText;
    }
