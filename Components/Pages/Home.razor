@page "/"
@rendermode InteractiveServer
@using System.Linq
@using StringTransforms
@using StringTransforms.BatchTransforms
@using StringTransforms.Transforms
@inject ITransformFactoryService TransformFactory
@inject IMacroFactoryService MacroFactory
@inject ITransformService TransformService
@inject IMathService MathService
@inject IJSRuntime JS

<PageTitle>Textr - Text Transformer</PageTitle>

<div class="container-fluid">
    <h1>Textr - Text Transformer</h1>

    <div class="row mt-3">
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Input Text</label>
                <textarea class="form-control font-monospace" rows="15" @bind="mainText" @bind:event="oninput" @onselectionchange="UpdateStatus"></textarea>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3">
                <label class="form-label">Result</label>
                <textarea class="form-control font-monospace" rows="15" value="@resultText" readonly></textarea>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Transforms</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Transform List</label>
                        <select class="form-select" size="6" value="@selectedTransformIndex" @onchange="OnSelectedTransformChanged">
                            @{
                                var transforms = transformCollection.AsDataSource();
                                for (int i = 0; i < transforms.Count; i++)
                                {
                                    var index = i;
                                    <option value="@index">@transforms[index]</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="btn-group mb-2" role="group">
                        <button class="btn btn-sm btn-danger" @onclick="RemoveSelectedTransform">Remove Selected</button>
                        <button class="btn btn-sm btn-warning" @onclick="ClearTransforms">Clear All</button>
                        <button class="btn btn-sm btn-secondary" @onclick="UndoTransform">Undo</button>
                        <button class="btn btn-sm btn-primary" @onclick="MoveTransformUp">Move Up</button>
                        <button class="btn btn-sm btn-primary" @onclick="MoveTransformDown">Move Down</button>
                    </div>
                    <div class="btn-group mb-2" role="group">
                        <button class="btn btn-sm btn-outline-dark" @onclick="EditSelectedTransform">Edit Selected</button>
                        <button class="btn btn-sm btn-outline-dark" @onclick="CancelEdit">Cancel Edit</button>
                    </div>
                    @if (!string.IsNullOrEmpty(editingInfo))
                    {
                        <div class="alert alert-light py-1 mb-0">
                            <small>@editingInfo</small>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Find & Replace</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-4">
                            <input type="text" class="form-control" placeholder="Find" @bind="findText" @bind:event="oninput" @onkeypress="OnFindKeyPress" />
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control" placeholder="Replace" @bind="replaceText" @bind:event="oninput" @onkeypress="OnReplaceKeyPress" />
                        </div>
                        <div class="col-md-4 d-flex align-items-center gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="caseSensitive" @bind="caseSensitive">
                                <label class="form-check-label" for="caseSensitive">Case Sensitive</label>
                            </div>
                            <button class="btn btn-primary btn-sm" @onclick="AddFindReplace">@(isEditingFindReplace ? "Save Edit" : "Add Replace")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Truncate</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-5">
                            <input type="text" class="form-control" placeholder="Truncate text" @bind="truncateText" @bind:event="oninput" @onkeypress="OnTruncateKeyPress" />
                        </div>
                        <div class="col-md-5 d-flex align-items-center gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="truncateFromStart" @bind="truncateFromStart">
                                <label class="form-check-label" for="truncateFromStart">From start</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="truncateCaseSensitive" @bind="truncateCaseSensitive">
                                <label class="form-check-label" for="truncateCaseSensitive">Case Sensitive</label>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary btn-sm" @onclick="AddTruncate">@(isEditingTruncate ? "Save Edit" : "Add Truncate")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>New Line After X Occurrences Of Y</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-2">
                            <input type="number" class="form-control" min="1" @bind="newLineOccurrences" @bind:event="oninput" />
                        </div>
                        <div class="col-md-4">
                            <input type="text" class="form-control" placeholder="Occurrences of" @bind="newLineToken" @bind:event="oninput" @onkeypress="OnNewLineAfterKeyPress" />
                        </div>
                        <div class="col-md-4 d-flex align-items-center gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="newLineBefore" @bind="newLineBefore">
                                <label class="form-check-label" for="newLineBefore">Before</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="newLineCaseSensitive" @bind="newLineCaseSensitive">
                                <label class="form-check-label" for="newLineCaseSensitive">Case Sensitive</label>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary btn-sm" @onclick="AddNewLineAfter">Add</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="btn-toolbar" role="toolbar">
                        <div class="btn-group me-2 mb-2" role="group">
                            <button class="btn btn-sm btn-outline-primary" @onclick="RemoveNewLines">Remove New Lines</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="NewLineCharFix">\\n or \\r to new line</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="RemoveBlankLines">Remove Blank Lines</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="Distinct">Distinct</button>
                        </div>
                        <div class="btn-group me-2 mb-2" role="group">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="AsteriskToParagraph">* → §</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ParagraphToAsterisk">§ → *</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CopyTab">Tab to clipboard</button>
                        </div>
                        <div class="btn-group me-2 mb-2" role="group">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="MathExpr">Math expr</button>
                        </div>
                        <div class="btn-group me-2 mb-2" role="group">
                            <button class="btn btn-sm btn-outline-success" @onclick="ApplyResult">Apply Result</button>
                            <button class="btn btn-sm btn-outline-success" @onclick="CopyToClipboard">Copy Result</button>
                        </div>
                        <div class="form-check ms-2 mb-2">
                            <input class="form-check-input" type="checkbox" id="autoApply" @bind="autoApply">
                            <label class="form-check-label" for="autoApply">Auto-apply</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Encoding</h5>
                </div>
                <div class="card-body">
                    <div class="btn-toolbar" role="toolbar">
                        <div class="btn-group me-2 mb-2" role="group">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="AsciiTo">⇒ ASCII</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="AsciiFrom">ASCII ⇒</button>
                        </div>
                        <div class="btn-group me-2 mb-2" role="group">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ToBase64">⇒ 64</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="FromBase64">64 ⇒</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>Format Conversion</h5>
                </div>
                <div class="card-body">
                    <div class="btn-toolbar" role="toolbar">
                        <div class="btn-group me-2 mb-2" role="group">
                            <button class="btn btn-sm btn-outline-info" @onclick="JsonToXml">JSON → XML</button>
                            <button class="btn btn-sm btn-outline-info" @onclick="XmlToJson">XML → JSON</button>
                        </div>
                        <div class="form-check ms-2 mb-2">
                            <input class="form-check-input" type="checkbox" id="xmlCasing" @bind="xmlPascalCase">
                            <label class="form-check-label" for="xmlCasing">&lt;PascalCase&gt;</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card mb-3">
                <div class="card-header">
                    <h5>SQL Macros</h5>
                </div>
                <div class="card-body">
                    <div class="btn-group flex-wrap" role="group">
                        <button class="btn btn-sm btn-outline-primary" @onclick="MacroListComma">List,</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="MacroListStringComma">'List',</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="MacroSqlSelect">SELECT</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="MacroSqlQuery">SQL Formatter</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="MacroSqlValues">Values()</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="MacroAddTableNames">tbl names</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="MacroGremlin">Gremlin</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5>Batch Edit</h5>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadResultIntoBatch">Load Result as Source</button>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label class="form-label">Source</label>
                                <textarea class="form-control font-monospace" rows="6" @bind="BatchSource" @bind:event="oninput"></textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Selection</label>
                                <input class="form-control font-monospace" @bind="BatchSelection" @bind:event="oninput" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Transform</label>
                                <input class="form-control font-monospace" @bind="BatchTransform" @bind:event="oninput" />
                            </div>
                            <div class="d-flex gap-3 mb-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="batchMode" id="batchSelectionMode" checked="@batchSelectionMode" @onchange="() => SetBatchMode(true)">
                                    <label class="form-check-label" for="batchSelectionMode">Selection mode</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="batchMode" id="batchFormatMode" checked="@(!batchSelectionMode)" @onchange="() => SetBatchMode(false)">
                                    <label class="form-check-label" for="batchFormatMode">Format mode</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="batchAsterisk" checked="@batchChangeAsterisk" @onchange="OnBatchAsteriskChanged">
                                    <label class="form-check-label" for="batchAsterisk">* ⇄ §</label>
                                </div>
                            </div>
                            <div class="small text-muted">
                                <div>@batchDescription</div>
                                <div>@batchTransformDescription</div>
                                @if (!string.IsNullOrEmpty(batchHint))
                                {
                                    <div>Hint: @batchHint</div>
                                }
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-2">
                                <label class="form-label">Selection View</label>
                                <textarea class="form-control font-monospace" rows="4" value="@batchSelectionView" readonly></textarea>
                            </div>
                            <div class="mb-2">
                                <label class="form-label">Result</label>
                                <textarea class="form-control font-monospace" rows="6" value="@batchResult" readonly></textarea>
                            </div>
                            <div class="btn-group mb-2" role="group">
                                <button class="btn btn-sm btn-outline-success" @onclick="UseBatchTransform">Use as Transform</button>
                                <button class="btn btn-sm btn-outline-success" @onclick="CopyBatchResult">Copy Result</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ResetBatchEdit">Re-init</button>
                            </div>
                            <div class="mt-3">
                                <label class="form-label">Cosmos Replace ("text,value" → find/replace)</label>
                                <div class="input-group mb-2">
                                    <input class="form-control" placeholder="Template with one *" @bind="batchCosmosText" />
                                    <button class="btn btn-outline-secondary" @onclick="ApplyBatchCosmosReplace">Replace</button>
                                    <button class="btn btn-outline-secondary" @onclick="SetBatchCosmosTemplate">Cosmos from VS</button>
                                </div>
                                @if (!string.IsNullOrEmpty(batchCosmosHint))
                                {
                                    <div class="small text-danger">@batchCosmosHint</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info">
                <small>@statusText</small>
            </div>
        </div>
    </div>
</div>

@code {
    private string _mainText = "";
    private string mainText
    {
        get => _mainText;
        set
        {
            if (_mainText == value) return;
            _mainText = value;
            UpdateResult();
        }
    }
    private string resultText = "";
    private string findText = "";
    private string replaceText = "";
    private bool caseSensitive = false;
    private string truncateText = "";
    private bool truncateFromStart = false;
    private bool truncateCaseSensitive = true;
    private int newLineOccurrences = 1;
    private string newLineToken = "";
    private bool newLineBefore = false;
    private bool newLineCaseSensitive = true;
    private bool xmlPascalCase = true;
    private bool autoApply = false;
    private string statusText = "Ready";
    private string editingInfo = "";
    private int selectedTransformIndex = -1;

    private EditableTransform? editingTransform = null;

    private ITransformCollection transformCollection = null!;

    private bool isEditingFindReplace => editingTransform?.GetEditableProperties() is FindReplaceProperties;
    private bool isEditingTruncate => editingTransform?.GetEditableProperties() is TruncateProperties;

    private string batchSource = "";
    private string batchSelection = "";
    private string batchTransform = "";
    private string batchResult = "";
    private string batchSelectionView = "";
    private bool batchSelectionMode = true;
    private bool batchChangeAsterisk = false;
    private string batchCosmosText = "";
    private string batchCosmosHint = "";
    private string batchDescription = "";
    private string batchTransformDescription = "";
    private string batchHint = "";
    private bool batchJustOpened = true;
    private bool batchTransformNotChanged = true;
    private List<IBatchEditLineTransform> batchLines = new();

    private string BatchSource
    {
        get => batchSource;
        set
        {
            if (batchSource == value) return;
            batchSource = value;
            OnBatchSourceChanged();
        }
    }

    private string BatchSelection
    {
        get => batchSelection;
        set
        {
            if (batchSelection == value) return;
            batchSelection = value;
            OnBatchSelectionChanged();
        }
    }

    private string BatchTransform
    {
        get => batchTransform;
        set
        {
            if (batchTransform == value) return;
            batchTransform = value;
            OnBatchTransformChanged();
        }
    }

    protected override void OnInitialized()
    {
        transformCollection = TransformService.GetNewTransformCollection();
        UpdateBatchModeInfo();
        UpdateResult();
    }

    private void UpdateResult()
    {
        resultText = TransformService.ApplyTransforms(transformCollection, _mainText);

        if (autoApply && transformCollection.Count > 0 && resultText != _mainText)
        {
            _mainText = resultText;
            TransformService.RemoveAllTransforms(transformCollection);
            resultText = _mainText;
        }

        UpdateStatus();
        StateHasChanged();
    }

    private void UpdateStatus()
    {
        statusText = $"Input length: {mainText.Length} | Result length: {resultText.Length} | Transforms: {transformCollection.Count}";
        if (!string.IsNullOrEmpty(editingInfo))
        {
            statusText += $" | {editingInfo}";
        }
    }

    private void AddTransform(ITransform transform)
    {
        TransformService.AddTransform(transform, transformCollection);
        UpdateResult();
    }

    private void AddMacro(IEnumerable<ITransform> transforms)
    {
        foreach (var transform in transforms)
        {
            TransformService.AddTransform(transform, transformCollection);
        }
        UpdateResult();
    }

    private void AddFindReplace()
    {
        statusText = $"AddFindReplace called: find='{findText}', replace='{replaceText}'";
        
        if (string.IsNullOrEmpty(findText))
        {
            statusText = "Find text is empty";
            return;
        }

        if (SaveEditIfActive(new FindReplaceProperties { Find = findText, Replace = replaceText, CaseSensitive = caseSensitive }))
        {
            findText = "";
            replaceText = "";
            return;
        }

        AddTransform(TransformFactory.CreateFindReplaceTransform(findText, replaceText, caseSensitive));
        statusText = $"Transform added! Count: {transformCollection.Count}";
        findText = "";
        replaceText = "";
    }

    private void AddTruncate()
    {
        if (string.IsNullOrEmpty(truncateText))
        {
            return;
        }

        var props = new TruncateProperties
        {
            Truncate = truncateText,
            FromStart = truncateFromStart,
            IgnoreCase = !truncateCaseSensitive
        };

        if (SaveEditIfActive(props))
        {
            return;
        }

        AddTransform(TransformFactory.CreateTruncateTransform(truncateFromStart, !truncateCaseSensitive, truncateText));
    }

    private bool SaveEditIfActive(IEditableProperties props)
    {
        if (editingTransform == null)
        {
            return false;
        }

        if (editingTransform.GetEditableProperties().GetType() != props.GetType())
        {
            return false;
        }

        editingTransform.Save(props);
        editingTransform = null;
        editingInfo = "Saved edit.";
        UpdateResult();
        return true;
    }

    private void EditSelectedTransform()
    {
        editingInfo = string.Empty;

        if (!TryGetSelectedTransform(out var selected))
        {
            editingInfo = "No transform selected.";
            return;
        }

        if (selected is not EditableTransform editable)
        {
            editingInfo = "Selected transform is not editable.";
            return;
        }

        var props = editable.Edit();
        editingTransform = editable;

        switch (props)
        {
            case FindReplaceProperties fr:
                findText = fr.Find;
                replaceText = fr.Replace;
                caseSensitive = fr.CaseSensitive;
                editingInfo = $"Editing {selected}";
                break;
            case TruncateProperties tp:
                truncateText = tp.Truncate;
                truncateFromStart = tp.FromStart;
                truncateCaseSensitive = !tp.IgnoreCase;
                editingInfo = $"Editing {selected}";
                break;
            default:
                editingTransform = null;
                editingInfo = "Selected transform is not editable.";
                break;
        }
    }

    private void CancelEdit()
    {
        editingTransform = null;
        editingInfo = "Cancelled edit.";
    }

    private void OnSelectedTransformChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var index))
        {
            selectedTransformIndex = index;
            if (transformCollection.Count > 0)
            {
                transformCollection.GetSelector().SetIndex(selectedTransformIndex);
            }
        }
    }

    private void OnFindKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddFindReplace();
        }
    }

    private void OnReplaceKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddFindReplace();
        }
    }

    private void OnTruncateKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTruncate();
        }
    }

    private void OnNewLineAfterKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddNewLineAfter();
        }
    }

    private void AddNewLineAfter()
    {
        if (newLineOccurrences <= 0 || string.IsNullOrEmpty(newLineToken))
        {
            return;
        }

        AddTransform(TransformFactory.CreateNewLineAfterXOccurencesOfY(newLineOccurrences, newLineToken, newLineCaseSensitive, newLineBefore));
    }

    private void RemoveSelectedTransform()
    {
        if (selectedTransformIndex >= 0 && selectedTransformIndex < transformCollection.Count)
        {
            transformCollection.GetSelector().SetIndex(selectedTransformIndex);
            TransformService.RemoveTranform(transformCollection);
            UpdateResult();
        }
    }

    private void ClearTransforms()
    {
        TransformService.RemoveAllTransforms(transformCollection);
        UpdateResult();
    }

    private void UndoTransform()
    {
        TransformService.Undo(transformCollection);
        UpdateResult();
    }

    private void MoveTransformUp()
    {
        if (selectedTransformIndex >= 0)
        {
            transformCollection.GetSelector().SetIndex(selectedTransformIndex);
            TransformService.MoveSelectedTransform(transformCollection, up: true);
            UpdateResult();
        }
    }

    private void MoveTransformDown()
    {
        if (selectedTransformIndex >= 0)
        {
            transformCollection.GetSelector().SetIndex(selectedTransformIndex);
            TransformService.MoveSelectedTransform(transformCollection, up: false);
            UpdateResult();
        }
    }

    private void RemoveNewLines() => AddTransform(TransformFactory.CreateRemoveNewLineTransform());
    private void NewLineCharFix() => AddTransform(TransformFactory.CreateNewLineCharFix());
    private void RemoveBlankLines() => AddTransform(TransformFactory.CreateRemoveBlankLinesTransform());
    private void Distinct() => AddTransform(TransformFactory.CreateDistinctTransform());
    private void AsteriskToParagraph() => AddTransform(TransformFactory.CreateFindReplaceTransform("*", "§"));
    private void ParagraphToAsterisk() => AddTransform(TransformFactory.CreateFindReplaceTransform("§", "*"));
    private void MathExpr() => AddTransform(TransformFactory.CreateMathTransform(MathService));
    private void AsciiTo()
    {
        AddTransform(TransformFactory.CreateFindReplaceTransform("\u00e5", @"\u00e5"));
        AddTransform(TransformFactory.CreateFindReplaceTransform("\u00e4", @"\u00e4"));
        AddTransform(TransformFactory.CreateFindReplaceTransform("\u00f6", @"\u00f6"));
        AddTransform(TransformFactory.CreateFindReplaceTransform("\u00c5", @"\u00c5"));
        AddTransform(TransformFactory.CreateFindReplaceTransform("\u00c4", @"\u00c4"));
        AddTransform(TransformFactory.CreateFindReplaceTransform("\u00d6", @"\u00d6"));
    }

    private void AsciiFrom()
    {
        AddTransform(TransformFactory.CreateFindReplaceTransform(@"\u00e5", "\u00e5"));
        AddTransform(TransformFactory.CreateFindReplaceTransform(@"\u00e4", "\u00e4"));
        AddTransform(TransformFactory.CreateFindReplaceTransform(@"\u00f6", "\u00f6"));
        AddTransform(TransformFactory.CreateFindReplaceTransform(@"\u00c5", "\u00c5"));
        AddTransform(TransformFactory.CreateFindReplaceTransform(@"\u00c4", "\u00c4"));
        AddTransform(TransformFactory.CreateFindReplaceTransform(@"\u00d6", "\u00d6"));
    }

