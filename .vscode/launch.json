{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch textr (Windows Forms)",
      "type": "clr",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/textr.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build",
      "stopAtEntry": false
    },
    {
      "name": "Launch textr (Blazor)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/bin/Debug/net8.0/textr.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://127.0.0.1:5100;https://127.0.0.1:5101"
      }
    }
  ]
}
